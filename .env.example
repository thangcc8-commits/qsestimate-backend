# ============================================================================
# QsEstimateApp — file mẫu biến môi trường
# ----------------------------------------------------------------------------
# KHÔNG dùng file này trực tiếp — copy thành ".env" (nếu chạy máy cá nhân) hoặc
# nhập từng biến vào Render → Environment (cách dùng thật trên production).
# KHÔNG BAO GIỜ commit file ".env" thật (có khoá thật) lên GitHub.
# ============================================================================

# --- BẮT BUỘC ---
ANTHROPIC_API_KEY=sk-ant-xxx_key_that_cua_ban
ACCESS_CODES=thang=PTC001,nam=PTC002
ADMIN_CODE=PTC001

# --- TUỲ CHỌN — có giá trị mặc định hợp lý nếu không set ---
ANTHROPIC_MODEL=claude-sonnet-4-6
ALLOWED_ORIGIN=*
PORT=3001

# --- TUỲ CHỌN — PostgreSQL (đã kích hoạt thật, test bằng DB thật, có sẵn cơ
# chế tự rơi về file JSON nếu Postgres lỗi/không cấu hình) ---
# DATABASE_URL=postgresql://user:pass@host:5432/qs

# --- TUỲ CHỌN — AI đa hãng (mục 23). Để trống nếu chỉ dùng Claude (mặc định)
# — không cần set gì thêm. ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza_xxx_key_gemini_cua_ban
# GEMINI_MODEL=gemini-1.5-pro
# OPENAI_API_KEY=sk-xxx_key_openai_cua_ban
# OPENAI_MODEL=gpt-4o

# --- TUỲ CHỌN — Google Cloud Vision OCR (bổ sung Claude, KHÔNG thay thế) —
# cho toạ độ pixel THẬT của chữ/số trên bản vẽ (Claude Vision không cho được
# điều này). Tính phí RIÊNG theo Google (khác gói Anthropic). Không đặt =
# không dùng được endpoint /api/ocr-vision, mọi thứ khác vẫn hoạt động bình
# thường. Key CHỈ ở server, không đưa vào frontend.
# GOOGLE_VISION_API_KEY=AIza_xxx_key_google_vision_cua_ban
# VISION_WITH_ANALYZE=0
